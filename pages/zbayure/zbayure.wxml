<view class="page">
  <block wx:if="{{isRulePage}}">
    <view class="rule-page">
      <view class="rule-hero">
        <view class="rule-hero-title">活动规则</view>
      </view>

      <view class="rule-content">
        <view class="rule-section-title">
          <view class="rule-title-bar"></view>
          <text>积分获取规则</text>
        </view>

        <view class="rule-sub-title">①每日助威积分</view>
        <view class="rule-table">
          <view class="rule-tr rule-th">
            <view class="rule-td rule-col-action">行为</view>
            <view class="rule-td rule-col-reward">积分奖励</view>
            <view class="rule-td rule-col-limit">限制</view>
          </view>
          <view class="rule-tr">
            <view class="rule-td rule-col-action">每日为支持的战队助威</view>
            <view class="rule-td rule-col-reward">10积分</view>
            <view class="rule-td rule-col-limit">每日1次</view>
          </view>
          <view class="rule-tr">
            <view class="rule-td rule-col-action">分享活动页面至朋友圈</view>
            <view class="rule-td rule-col-reward">额外获得5积分</view>
            <view class="rule-td rule-col-limit">每日1次</view>
          </view>
        </view>

        <view class="rule-sub-title rule-reward-title">
          <text>②人气值达标瓜分奖励</text>
          <text class="rule-note">（每人每档积分仅限参与1次）</text>
        </view>
        <view class="rule-table">
          <view class="rule-tr rule-th">
            <view class="rule-td rule-col-level">门槛档位</view>
            <view class="rule-td rule-col-condition">触发条件</view>
            <view class="rule-td rule-col-points">积分奖励</view>
          </view>
          <view class="rule-tr">
            <view class="rule-td rule-col-level">铜牌人气</view>
            <view class="rule-td rule-col-condition">队伍助威人气值达 3000</view>
            <view class="rule-td rule-col-points">50积分</view>
          </view>
          <view class="rule-tr">
            <view class="rule-td rule-col-level">银牌人气</view>
            <view class="rule-td rule-col-condition">队伍助威人气值达 5000</view>
            <view class="rule-td rule-col-points">100积分</view>
          </view>
          <view class="rule-tr">
            <view class="rule-td rule-col-level">金牌人气</view>
            <view class="rule-td rule-col-condition">队伍助威人气值达 10000</view>
            <view class="rule-td rule-col-points">200积分</view>
          </view>
        </view>

        <view class="rule-sub-title rule-guess-title">③竞猜大奖</view>
        <view class="rule-table">
          <view class="rule-tr rule-th">
            <view class="rule-td rule-col-prize">奖项</view>
            <view class="rule-td rule-col-award">奖励</view>
          </view>
          <view class="rule-tr">
            <view class="rule-td rule-col-prize">参与竞猜</view>
            <view class="rule-td rule-col-award">获得10积分</view>
          </view>
          <view class="rule-tr">
            <view class="rule-td rule-col-prize">猜中1队</view>
            <view class="rule-td rule-col-award">额外奖励100积分</view>
          </view>
          <view class="rule-tr">
            <view class="rule-td rule-col-prize">2队全猜中</view>
            <view class="rule-td rule-col-award">额外奖励500积分</view>
          </view>
        </view>

        <view class="rule-section-title rule-popularity-title">
          <view class="rule-title-bar"></view>
          <text>助威人气值设定</text>
        </view>
        <view class="rule-popularity-desc">人气值=助威行为累计（每人每次助力贡献10点人气值）</view>
      </view>
    </view>
  </block>

  <block wx:else>
  <image class="hero-image" src="{{heroImage}}" mode="aspectFill"></image>

  <view class="float-actions">
    <image
      wx:for="{{floatButtons}}"
      wx:key="type"
      class="float-action"
      src="{{item.icon}}"
      mode="widthFix"
      data-type="{{item.type}}"
      bindtap="handleFloatTap"
    ></image>
  </view>

  <view class="play-section">
    <image class="section-title support-title" src="{{supportGuessTitle}}" mode="widthFix"></image>

    <view class="play-panel">
      <view class="play-tabs play-tabs-{{currentPlayTab}}">
        <view
          wx:for="{{playTabs}}"
          wx:key="type"
          class="play-tab play-tab-{{item.type}} {{currentPlayTab === item.type ? 'play-tab-active' : ''}}"
          data-type="{{item.type}}"
          bindtap="switchPlayTab"
        >
          <text>{{item.text}}</text>
        </view>
      </view>

      <view class="prediction-wrap prediction-wrap-{{currentPlayTab}}">
        <view class="prediction-card">
          <view class="prediction-match-date">9月22日 19:30</view>
          <view class="prediction-match">
            <view class="prediction-team">
              <image class="prediction-team-logo prediction-team-logo-linhai" src="{{match.linhai.logo}}" mode="aspectFit"></image>
              <text class="prediction-team-name">临海队</text>
            </view>
            <view class="prediction-vs">
              <image class="prediction-vs-image" src="{{match.vsLogo}}" mode="aspectFit"></image>
              <text class="prediction-mode">{{currentPlayTab === 'support' ? '猜胜负' : '猜比分'}}</text>
            </view>
            <view class="prediction-team">
              <image class="prediction-team-logo prediction-team-logo-ruian" src="{{match.ruian.logo}}" mode="aspectFit"></image>
              <text class="prediction-team-name">瑞安队</text>
            </view>
          </view>

          <block wx:if="{{currentPlayTab === 'support'}}">
            <view class="winner-options">
              <view
                class="winner-option winner-option-left {{selectedWinner === 'linhai' ? 'winner-option-selected' : ''}}"
                data-winner="linhai"
                bindtap="selectWinner"
              >
                <image
                  class="winner-option-image"
                  src="{{selectedWinner === 'linhai' ? winnerOptionAssets.linhaiActive : winnerOptionAssets.linhaiInactive}}"
                  mode="widthFix"
                ></image>
              </view>
              <view
                class="winner-option winner-option-right {{selectedWinner === 'ruian' ? 'winner-option-selected' : ''}}"
                data-winner="ruian"
                bindtap="selectWinner"
              >
                <image
                  class="winner-option-image"
                  src="{{selectedWinner === 'ruian' ? winnerOptionAssets.ruianActive : winnerOptionAssets.ruianInactive}}"
                  mode="widthFix"
                ></image>
              </view>
            </view>
          </block>
          <block wx:else>
            <view class="score-options">
              <input class="score-input score-input-left" type="number" maxlength="3" placeholder="" value="{{scoreGuess.linhai}}" disabled="{{guessLoading || guessSubmitted || guessExpired}}" data-team="linhai" bindinput="onScoreInput" />
              <view class="score-colon">:</view>
              <input class="score-input score-input-right" type="number" maxlength="3" placeholder="" value="{{scoreGuess.ruian}}" disabled="{{guessLoading || guessSubmitted || guessExpired}}" data-team="ruian" bindinput="onScoreInput" />
            </view>
          </block>

        </view>
        <button
          class="guess-submit {{guessLoading || guessSubmitted || guessExpired ? 'guess-submit-disabled' : ''}}"
          disabled="{{guessLoading || guessSubmitted || guessExpired}}"
          bindtap="handleGuessSubmit"
        >{{guessExpired ? '竞猜已截止' : (guessLoading ? '提交中' : '确认提交')}}</button>
        <view class="guess-deadline">{{guessExpired ? '当前场次竞猜已截止' : ('竞猜截止时间：' + guessDeadlineText)}}</view>
      </view>
    </view>
  </view>

  <view class="exchange-section">
    <image class="section-title exchange-title" src="{{healthExchangeTitle}}" mode="widthFix"></image>

    <view class="exchange-panel">
      <view class="health-tabs">
        <view
          wx:for="{{healthTabs}}"
          wx:key="key"
          class="health-tab {{currentHealthTab === item.key ? 'health-tab-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="switchHealthTab"
        >
          <text>{{item.name}}</text>
        </view>
      </view>

      <view wx:if="{{goodsLoading}}" class="goods-empty">加载中...</view>
      <view wx:elif="{{exchangeItems.length}}" class="goods-grid">
        <view wx:for="{{exchangeItems}}" wx:key="id" class="gift-card">
          <image wx:if="{{item.image}}" class="coupon-art" src="{{item.image}}" mode="widthFix"></image>
          <view wx:else class="coupon-art coupon-art-empty">{{item.title}}</view>
          <view class="gift-desc">{{item.desc}}</view>
          <view class="gift-bottom">
            <view class="gift-points">
              <text>{{item.points}}</text>积分<text wx:if="{{item.priceText}}" class="gift-price-plus">+¥{{item.priceText}}</text>
            </view>
            <view class="redeem-button" data-id="{{item.id}}" catchtap="handleRedeem">立即兑</view>
          </view>
        </view>
      </view>
      <view wx:else class="goods-empty">暂无可兑换商品</view>
    </view>
  </view>

  <view wx:if="{{showMyGuessModal}}" class="my-guess-mask" catchtap="closeMyGuessModal" catchtouchmove="noop">
    <view class="my-guess-dialog" catchtap="noop">
      <view class="my-guess-title">我的竞猜</view>
      <view class="my-guess-content">
        <view wx:if="{{myGuessLoading}}" class="my-guess-empty">加载中...</view>
        <view wx:elif="{{myGuessTeams.length}}" class="my-guess-list">
          <view wx:for="{{myGuessTeams}}" wx:key="id" class="my-guess-team">
            <view class="my-guess-logo-wrap">
              <image class="my-guess-logo" src="{{item.logo}}" mode="aspectFit"></image>
            </view>
            <view class="my-guess-name">{{item.name}}</view>
          </view>
        </view>
        <view wx:else class="my-guess-empty">暂无竞猜记录</view>
      </view>
    </view>
    <view class="my-guess-close" catchtap="closeMyGuessModal"></view>
  </view>
  </block>
</view>
