page {
  background: #f3f7f8;
}

.sign-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f3f7f8;
}

.sign-header {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 48px;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  border-bottom: 1px solid #e1e9ec;
  background: #fff;
}

.sign-close,
.sign-header-space {
  width: 40px;
  height: 40px;
}

.sign-close {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #536a74;
  font-size: 30px;
  font-weight: 300;
  line-height: 40px;
}

.sign-title {
  color: #1f3b48;
  font-size: 20px;
  font-weight: 600;
  line-height: 1;
}

.sign-canvas-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
  margin: 8px 16px 6px;
  overflow: hidden;
  border: 1px solid #d6e2e6;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 4px 14px rgba(49, 79, 90, 0.06);
}

.sign-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.sign-hint {
  position: absolute;
  top: 50%;
  right: 0;
  left: 0;
  color: #b2c0c5;
  font-size: 18px;
  text-align: center;
  transform: translateY(-50%);
  pointer-events: none;
}

.sign-actions {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 56px;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  padding: 6px 16px calc(6px + env(safe-area-inset-bottom));
  border-top: 1px solid #e1e9ec;
  background: #fff;
}

.sign-button {
  flex: 0 0 140px;
  height: 40px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 20px;
  font-size: 16px;
  font-weight: 600;
  line-height: 40px;
}

.sign-button::after {
  border: 0;
}

.sign-button.secondary {
  background: #edf2f4;
  color: #46616d;
}

.sign-button.primary {
  flex-basis: 160px;
  background: #2b7f87;
  color: #fff;
}
