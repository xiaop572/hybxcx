<view class="page">
  <view class="title">医美AI面部综合评估</view>
  <view class="subtitle">正在识别面部问题、皮肤问题、美容整形等</view>

  <view class="circle-wrap">
    <view class="circle-halo"></view>
    <view class="circle-inner"></view>
    <canvas
      canvas-id="progressCanvas"
      style="width:{{canvasPx}}px;height:{{canvasPx}}px;"
      class="canvas"
    ></canvas>
    <view class="center-text">
      <text class="num">{{percent}}</text><text class="sign">%</text>
    </view>
  </view>

  <view class="hint">预计 20-30 秒完成，请保持页面停留</view>
  <view class="request-state-card">
    <view class="request-state-title">当前状态</view>
    <view class="request-state-text">{{requestStateText}}</view>
  </view>
  <view class="timing-card">
    <view class="timing-title">{{timingTitle}}</view>
    <view class="timing-text">{{timingDetail}}</view>
  </view>
</view>
