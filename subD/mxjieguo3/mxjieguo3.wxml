<!--pages/mxjieguo3/mxjieguo3.wxml-->
<view class="chat-page">
  <scroll-view id="main-scroll" class="page" scroll-y scroll-with-animation scroll-into-view="{{scrollIntoView}}" scroll-top="{{pageScrollTop}}" bindscroll="handleMainScroll">
    <view class="result-hero">
      <view class="hero-title">{{ui.heroTitle}}</view>
      <view class="hero-subtitle">{{ui.heroSubtitle}}</view>
      <view class="hero-line"></view>
    </view>

    <view class="overall-card" wx:if="{{report.overallIntro || report.overallSections.length}}">
      <view class="overall-head">
        <view class="overall-title">{{ui.overallTitle}}</view>
        <view wx:if="{{overallSpeechText}}" class="overall-voice-btn {{speakingOverall ? 'overall-voice-btn-active' : ''}}" bindtap="toggleOverallSpeech">{{speakingOverall ? ui.stop : ui.speak}}</view>
      </view>
      <view wx:if="{{report.overallIntro}}" class="overall-intro">{{report.overallIntro}}</view>
    </view>

    <view class="overall-grid" wx:if="{{report.overallSections.length}}">
      <view class="overall-item" wx:for="{{report.overallSections}}" wx:key="title">
        <view class="overall-item-head">
          <view class="overall-item-index">{{item.index}}</view>
          <view class="overall-item-title">{{item.title}}</view>
        </view>
        <view class="overall-item-content">{{item.content}}</view>
      </view>
    </view>

    <view class="image-echo-section" wx:if="{{imageEchoList.length}}">
      <scroll-view class="image-echo-scroll" scroll-x scroll-with-animation enhanced show-scrollbar="{{false}}" scroll-left="{{imageEchoScrollLeft}}">
        <view class="image-echo-row">
            <view class="image-echo-card {{activeEchoCardIndex === index ? 'image-echo-card-active' : ''}} {{item.action === 'toggle-drilldown' && showVisualDrilldown ? 'image-echo-card-drilldown-open' : ''}}" id="image-echo-card-{{index}}" wx:for="{{imageEchoList}}" wx:key="title" bindtap="handleImageEchoTap" data-index="{{index}}">
            <view class="image-echo-preview">
              <block wx:if="{{item.previewCard}}">
                <view class="focus-crop-frame" style="{{item.previewCard.frameStyle}}">
                  <image class="focus-crop-img" src="{{item.previewCard.source}}" mode="widthFix" style="{{item.previewCard.imageStyle}}"></image>
                  <view wx:for="{{item.previewCard.points}}" wx:for-item="point" wx:key="index" class="focus-point {{point.active ? 'focus-point-active' : ''}}" style="{{point.style}}">
                    <text wx:if="{{point.active}}" class="focus-point-label" style="{{point.labelStyle}}">{{point.index}}</text>
                  </view>
                  <view wx:for="{{item.previewCard.boxes}}" wx:for-item="box" wx:key="label" class="focus-box" style="{{box.style}}">
                    <text class="focus-box-label">{{box.label}}</text>
                  </view>
                </view>
              </block>
              <image wx:else class="image-echo-img" src="{{item.image}}" mode="aspectFill"></image>
            </view>
            <view class="image-echo-body">
              <view class="image-echo-title">{{item.title}}</view>
              <view class="image-echo-desc">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view id="visual-drilldown-anchor" class="visual-drilldown" wx:if="{{showVisualDrilldown && visualDetailSections.length}}">
      <view class="visual-drilldown-head">
        <view class="visual-drilldown-title">{{ui.drilldownTitle}}</view>
        <view class="visual-drilldown-subtitle">{{ui.drilldownSubtitle}}</view>
      </view>
      <view class="drilldown-stack">
        <view class="drilldown-card" wx:for="{{visualDetailSections}}" wx:for-index="sectionIndex" wx:key="key" bindtap="previewVisualSectionImage" data-section-index="{{sectionIndex}}" data-image-index="0">
          <view class="drilldown-figure">
            <block wx:if="{{item.previewCard}}">
              <view class="focus-crop-frame" style="{{item.previewCard.frameStyle}}">
                <image class="focus-crop-img" src="{{item.previewCard.source}}" mode="aspectFit" style="{{item.previewCard.imageStyle}}"></image>
                <view wx:for="{{item.previewCard.points}}" wx:for-item="point" wx:key="index" class="focus-point {{point.active ? 'focus-point-active' : ''}}" style="{{point.style}}">
                  <text wx:if="{{point.active}}" class="focus-point-label" style="{{point.labelStyle}}">{{point.index}}</text>
                </view>
                <view wx:for="{{item.previewCard.boxes}}" wx:for-item="box" wx:key="label" class="focus-box" style="{{box.style}}">
                  <text class="focus-box-label">{{box.label}}</text>
                </view>
              </view>
            </block>
            <image wx:else class="drilldown-img {{item.key === 'aesthetic' ? 'aesthetic-focus-img' : ''}}" src="{{item.src}}" mode="aspectFill"></image>
          </view>
          <view class="drilldown-card-body">
            <view class="drilldown-eyebrow">{{item.eyebrow}}</view>
            <view class="drilldown-title">{{item.title}}</view>
            <view class="drilldown-note">{{item.note}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card chat-section">
      <view class="section-head">
        <view class="section-title">{{ui.chatTitle}}</view>
        <view class="section-tip"></view>
      </view>
      <view class="chat-tips">{{ui.chatTips}}</view>
      <view class="quick-question-list">
        <view class="quick-question" wx:for="{{quickQuestions}}" wx:key="index" bindtap="askQuickQuestion" data-text="{{item}}">{{item}}</view>
      </view>
      <view class="quick-question-tip">{{ui.quickQuestionTip}}</view>
      <view class="chat-list">
        <view wx:for="{{chatMessages}}" wx:key="id" id="msg-{{item.id}}" class="chat-item {{item.role === 'user' ? 'chat-item-user' : 'chat-item-assistant'}}">
          <view class="chat-avatar">{{item.role === 'user' ? ui.me : ui.assistant}}</view>
          <view class="chat-main">
            <image wx:if="{{item.image}}" class="chat-image" src="{{item.image}}" mode="aspectFill" bindtap="previewChatImage" data-url="{{item.image}}"></image>
            <view wx:if="{{item.loading}}" class="chat-bubble chat-bubble-assistant chat-bubble-thinking">
              <text class="thinking-text">正在思考</text>
              <view class="thinking-dots">
                <view class="thinking-dot"></view>
                <view class="thinking-dot"></view>
                <view class="thinking-dot"></view>
              </view>
            </view>
            <view wx:elif="{{item.content}}" class="chat-bubble {{item.role === 'user' ? 'chat-bubble-user' : 'chat-bubble-assistant'}}">{{item.content}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="page-bottom-space"></view>
  </scroll-view>

  <view class="composer">
    <view wx:if="{{pendingImage}}" class="composer-preview">
      <image class="composer-preview-image" src="{{pendingImage}}" mode="aspectFill" bindtap="previewChatImage" data-url="{{pendingImage}}"></image>
      <view class="composer-preview-remove" bindtap="removePendingImage">{{ui.remove}}</view>
    </view>
    <view class="composer-row">
      <view class="composer-upload" bindtap="chooseChatImage">{{ui.attachImage}}</view>
      <input class="composer-input" placeholder="{{ui.inputPlaceholder}}" value="{{draftText}}" maxlength="300" bindinput="onDraftInput" bindconfirm="sendChatMessage" confirm-type="send" cursor-spacing="20" />
      <view class="composer-send {{canSendChat ? 'composer-send-active' : ''}}" bindtap="sendChatMessage">{{sendingChat ? ui.sending : ui.send}}</view>
    </view>
  </view>

  <view class="detail-modal-mask" wx:if="{{showDetailModal}}" bindtap="closeDetailModal">
    <view class="detail-modal" catchtap="preventBubble">
      <view class="detail-modal-head">
        <view>
          <view class="detail-modal-title">{{currentDetail.modalTitle || currentDetail.title}}</view>
          <view class="detail-modal-intro">{{currentDetail.modalIntro || currentDetail.desc}}</view>
        </view>
        <view class="detail-modal-close" bindtap="closeDetailModal">{{ui.close}}</view>
      </view>
      <view wx:if="{{currentDetail.highlights}}" class="detail-highlight-row">
        <view class="detail-highlight-text">{{currentDetail.highlights}}</view>
      </view>
      <view class="detail-modal-scroll-wrap">
        <view class="detail-modal-drag-handle"></view>
        <scroll-view class="detail-modal-scroll" scroll-y>
          <view wx:if="{{currentDetail.previewCard || currentDetail.image}}" class="detail-modal-preview">
            <block wx:if="{{currentDetail.previewCard}}">
              <view class="focus-crop-frame detail-modal-preview-frame" style="{{currentDetail.previewCard.frameStyle}}" catchtap="previewModalImage" data-url="{{currentDetail.previewCard.source}}">
                <image class="focus-crop-img" src="{{currentDetail.previewCard.source}}" mode="aspectFit" style="{{currentDetail.previewCard.imageStyle}}"></image>
              </view>
            </block>
            <image wx:else class="detail-modal-preview-image" src="{{currentDetail.image}}" mode="widthFix" catchtap="previewModalImage" data-url="{{currentDetail.image}}"></image>
          </view>
          <view wx:if="{{currentDetail.focusCards && currentDetail.focusCards.length}}" class="detail-modal-focus-zone">
            <view class="detail-modal-focus-title">{{currentDetail.focusTitle || ui.focusTitle}}</view>
            <view class="detail-focus-list">
              <view class="detail-focus-card" wx:for="{{currentDetail.focusCards}}" wx:for-item="focus" wx:for-index="focusIndex" wx:key="key" bindtap="previewDetailBlockFocusCard" data-block-index="-1" data-focus-index="{{focusIndex}}">
                <view class="focus-crop-frame detail-focus-frame" style="{{focus.frameStyle}}" catchtap="previewModalImage" data-url="{{focus.source}}">
                  <image class="focus-crop-img" src="{{focus.source}}" mode="aspectFit" style="{{focus.imageStyle}}"></image>
                </view>
                <view class="detail-focus-title">{{focus.title}}</view>
                <view class="detail-focus-desc">{{focus.summary}}</view>
              </view>
            </view>
          </view>
          <view class="detail-modal-block {{index === 0 ? 'detail-modal-block-primary' : ''}}" wx:for="{{currentDetail.blocks}}" wx:key="title">
            <view wx:if="{{item.level || item.label}}" class="detail-block-meta">{{item.level}} {{item.label}}</view>
            <view class="detail-block-title">{{item.title}}</view>
            <view wx:if="{{item.desc}}" class="detail-block-line">{{item.desc}}</view>
            <view wx:if="{{item.refs}}" class="detail-block-line">{{ui.refsLabel}}{{item.refs}}</view>
            <view wx:if="{{item.consult}}" class="detail-block-line">{{ui.consultLabel}}{{item.consult}}</view>
            <view wx:if="{{item.tip}}" class="detail-block-line">{{ui.tipLabel}}{{item.tip}}</view>
          </view>
        </scroll-view>
        <view class="detail-modal-scroll-cue">
          <view class="detail-modal-scroll-text">{{ui.scrollMore}}</view>
          <view class="detail-modal-scroll-arrow"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showFocusPreview && focusPreviewCard}}" class="focus-preview-mask" bindtap="closeFocusPreview">
    <view class="focus-preview-modal" catchtap="preventBubble">
      <view class="focus-preview-head">
        <view class="focus-preview-title">{{focusPreviewCard.title || ui.focusTitle}}</view>
        <view class="focus-preview-close" bindtap="closeFocusPreview">{{ui.close}}</view>
      </view>
      <view class="focus-preview-body">
        <view class="focus-crop-frame focus-preview-frame" style="{{focusPreviewCard.frameStyle}}" catchtap="previewModalImage" data-url="{{focusPreviewCard.source}}">
          <image class="focus-crop-img" src="{{focusPreviewCard.source}}" mode="aspectFit" style="{{focusPreviewCard.imageStyle}}"></image>
        </view>
        <view wx:if="{{focusPreviewCard.summary}}" class="focus-preview-desc">{{focusPreviewCard.summary}}</view>
      </view>
    </view>
  </view>
</view>
