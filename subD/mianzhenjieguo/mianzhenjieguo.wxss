/* subpackagesC/mianzhenjieguo/mianzhenjieguo.wxss */
page {
  background: linear-gradient(180deg, #5aaaf4 0%, #8bc5fb 42%, #d8ecff 100%);
  min-height: 100%;
  height: 100%;
  padding-bottom: 80rpx;
}

.chat-page {
  position: relative;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  height: 100vh;
  padding: 36rpx 24rpx 0;
  box-sizing: border-box;
}

.result-hero {
  position: relative;
  overflow: hidden;
  min-height: 170rpx;
  padding: 34rpx 34rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.1) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 20rpx 50rpx rgba(17, 104, 214, 0.18);
  box-sizing: border-box;
}

.result-hero::before {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -86rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
}


.hero-kicker {
  position: relative;
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.hero-title {
  position: relative;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  text-shadow: 0 8rpx 20rpx rgba(32, 93, 166, 0.22);
}

.hero-subtitle {
  position: relative;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  line-height: 1.65;
}

.hero-line {
  width: 116rpx;
  height: 7rpx;
  margin: 18rpx auto 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.timing-card {
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 40rpx rgba(26, 111, 204, 0.12);
  box-sizing: border-box;
}

.timing-card-title {
  color: #123f66;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.timing-card-subtitle {
  margin-top: 18rpx;
  color: #2a78b6;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
}

.timing-card-content {
  margin-top: 12rpx;
  color: #425c70;
  font-size: 25rpx;
  line-height: 1.8;
  word-break: break-word;
  white-space: pre-wrap;
}

.timing-card-content-secondary {
  color: #5c7386;
}

.header-card,
.section-card {
  background: #ffffff;
  border-radius: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 32rpx rgba(124, 92, 246, 0.08);
}

.header-card {
  padding: 40rpx 36rpx 36rpx;
  margin-bottom: 24rpx;
}

.header-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.header-left {
  flex: 1;
  padding-right: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #222222;
  line-height: 1.3;
}

.sub-title {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #7a7f8f;
  line-height: 1.8;
}

.header-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a78bfa 0%, #38bdf8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.summary-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 156rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: linear-gradient(90deg, rgba(124, 92, 246, 0.12), rgba(56, 189, 248, 0.12));
  color: #6a53dd;
  font-size: 24rpx;
  font-weight: 600;
}

.summary-text {
  margin-top: 20rpx;
  font-size: 27rpx;
  color: #545b66;
  line-height: 1.9;
  white-space: pre-wrap;
}

.overview-row {
  display: flex;
  margin-top: 28rpx;
  gap: 20rpx;
}

.overview-pill {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #faf8ff 0%, #f2f8ff 100%);
}

.overview-pill-label {
  display: block;
  font-size: 22rpx;
  color: #96a0af;
  margin-bottom: 10rpx;
}

.overview-pill-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #5a44d6;
  line-height: 1.4;
  word-break: break-all;
}

.image-echo-section {
  margin-bottom: 24rpx;
}

.image-echo-scroll {
  width: 100%;
  white-space: nowrap;
}

.image-echo-row {
  display: flex;
  gap: 18rpx;
  padding-right: 48rpx;
  padding-bottom: 4rpx;
}

.image-echo-card {
  position: relative;
  width: 520rpx;
  min-width: 520rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 40rpx rgba(26, 111, 204, 0.12);
  box-sizing: border-box;
  transition: box-shadow 0.22s ease, border-color 0.22s ease, background 0.22s ease;
}

.image-echo-card-active {
  border-color: #157cff;
  background: #ffffff;
  box-shadow: 0 28rpx 66rpx rgba(21, 124, 255, 0.34), inset 0 0 0 6rpx rgba(21, 124, 255, 0.12);
  transform: translateY(-6rpx) scale(1.02);
}

.image-echo-card-drilldown-open {
  border-color: #157cff;
}

.image-echo-card-active::after {
  content: "";
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #157cff;
  box-shadow: 0 0 0 8rpx rgba(21, 124, 255, 0.18);
  z-index: 3;
}

.image-echo-body {
  padding: 20rpx 22rpx 24rpx;
}

.image-echo-title {
  color: #123f66;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.image-echo-meta {
  flex: 1;
  min-width: 0;
  color: #667b8b;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.image-echo-preview {
  height: 360rpx;
  background: #fbfdfd;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-echo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.image-echo-desc {
  margin-top: 10rpx;
  color: #526878;
  font-size: 23rpx;
  line-height: 1.7;
  white-space: normal;
  word-break: break-word;
}

.overall-card {
  position: relative;
  overflow: hidden;
  padding: 36rpx 34rpx 34rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 44rpx rgba(26, 111, 204, 0.14);
  box-sizing: border-box;
}

.overall-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.overall-title {
  font-size: 32rpx;
  color: #164b7b;
  font-weight: 700;
  line-height: 1.45;
}

.overall-voice-btn {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: #eaf7ff;
  border: 1rpx solid rgba(42, 143, 255, 0.18);
  color: #157cff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
  text-align: center;
  box-sizing: border-box;
}

.overall-voice-btn-active {
  background: #fff2f2;
  border-color: rgba(239, 98, 98, 0.22);
  color: #ef6262;
}

.overall-intro {
  margin-top: 18rpx;
  color: #4e6578;
  font-size: 26rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  word-break: break-word;
}

.overall-grid {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-bottom: 24rpx;
}

.overall-item {
  width: 100%;
  padding: 30rpx 30rpx 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 30rpx;
  box-shadow: 0 16rpx 40rpx rgba(26, 111, 204, 0.12);
  box-sizing: border-box;
}

.overall-item-head {
  display: flex;
  align-items: center;
}

.overall-item-index {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #157cff 0%, #43b7ff 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 22rpx rgba(21, 124, 255, 0.28);
}

.overall-item-title {
  color: #123f66;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.4;
}

.overall-item-content {
  margin-top: 20rpx;
  padding-left: 64rpx;
  color: #385468;
  font-size: 26rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  word-break: break-word;
}

.visual-drilldown {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 40rpx rgba(26, 111, 204, 0.12);
  box-sizing: border-box;
}

.visual-drilldown-head {
  margin-bottom: 22rpx;
}

.visual-drilldown-title {
  color: #123f66;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.visual-drilldown-subtitle {
  margin-top: 8rpx;
  color: #627686;
  font-size: 23rpx;
  line-height: 1.7;
}

.drilldown-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.drilldown-card {
  display: flex;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(84, 118, 144, 0.14);
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}

.drilldown-figure {
  width: 210rpx;
  height: 210rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 20rpx;
  background: #edf3fa;
}

.drilldown-img {
  width: 100%;
  height: 100%;
  display: block;
}

.aesthetic-focus-img {
  transform: none;
}

.drilldown-card-body {
  flex: 1;
  min-width: 0;
}

.drilldown-eyebrow {
  color: #58769b;
  font-size: 20rpx;
  line-height: 1.4;
}

.drilldown-title {
  margin-top: 6rpx;
  color: #17314f;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.45;
}

.drilldown-note {
  margin-top: 8rpx;
  color: #516578;
  font-size: 23rpx;
  line-height: 1.72;
  white-space: normal;
  word-break: break-word;
}

.drilldown-gallery {
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}

.drilldown-gallery-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 2rpx;
}

.drilldown-thumb {
  width: 92rpx;
  height: 92rpx;
  min-width: 92rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #edf3fa;
  border: 2rpx solid transparent;
}

.drilldown-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.mole-focus-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.mole-focus-card {
  width: calc((100% - 16rpx) / 2);
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 95, 174, 0.12);
  box-sizing: border-box;
}

.mole-focus-img {
  width: 100%;
  height: 220rpx;
  display: block;
  background: #edf3fa;
}

.mole-focus-title {
  padding: 14rpx 16rpx 16rpx;
  color: #516578;
  font-size: 24rpx;
  line-height: 1.45;
  white-space: normal;
  word-break: break-word;
}

.detail-image-section {
  margin-bottom: 24rpx;
}

.detail-image-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.detail-image-main-title {
  color: #ffffff;
  text-shadow: 0 6rpx 16rpx rgba(32, 93, 166, 0.18);
  flex-shrink: 0;
}

.detail-image-tip {
  flex: 1;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: right;
}

.detail-image-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-image-card {
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 14rpx 34rpx rgba(26, 111, 204, 0.1);
  box-sizing: border-box;
}

.detail-image-card-active {
  border-color: #59c8ff;
  box-shadow: 0 18rpx 42rpx rgba(28, 143, 230, 0.2);
}

.detail-image-preview {
  border-radius: 22rpx;
  overflow: hidden;
  background: #f6fbff;
  border: 1rpx solid rgba(76, 118, 148, 0.16);
}

.detail-image-img {
  width: 100%;
  display: block;
}

.focus-crop-frame {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 100%;
  overflow: hidden;
  border-radius: 18rpx;
  background: #eef5fb;
}

.detail-preview-focus {
  border-radius: 22rpx;
}

.focus-crop-img {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
}

.focus-point {
  position: absolute;
  border-radius: 50%;
  background: rgba(0, 208, 255, 0.22);
  border: 2rpx solid rgba(231, 249, 255, 0.38);
  box-sizing: border-box;
}

.focus-point-active {
  background: rgba(255, 94, 58, 0.96);
  border: 5rpx solid rgba(255, 245, 240, 0.98);
  box-shadow: 0 6rpx 14rpx rgba(255, 94, 58, 0.22);
}

.focus-point-label {
  position: absolute;
  color: #ff765c;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 900;
  text-shadow:
    -2rpx -2rpx 0 #10202b,
    2rpx -2rpx 0 #10202b,
    -2rpx 2rpx 0 #10202b,
    2rpx 2rpx 0 #10202b;
}

.focus-box {
  position: absolute;
  border: 4rpx solid rgba(255, 94, 58, 0.98);
  border-radius: 16rpx;
  background: rgba(255, 94, 58, 0.08);
  box-shadow: 0 8rpx 20rpx rgba(255, 94, 58, 0.18);
  box-sizing: border-box;
}

.focus-box-label {
  position: absolute;
  left: 0;
  top: 0;
  transform: translateY(-100%);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 94, 58, 0.96);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.5;
  white-space: nowrap;
}

.detail-image-title {
  margin-top: 22rpx;
  color: #123f66;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
}

.detail-image-desc {
  margin-top: 10rpx;
  color: #526878;
  font-size: 24rpx;
  line-height: 1.7;
}

.section-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b2b2b;
  line-height: 1.4;
}

.section-tip {
  font-size: 22rpx;
  color: #9aa0ab;
  flex-shrink: 0;
}

.photo-wrap {
  width: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #f7f8ff 0%, #eef4ff 100%);
  border: 2rpx solid rgba(124, 92, 246, 0.08);
}

.face-image {
  width: 100%;
  display: block;
}

.photo-wrap-empty {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-empty,
.empty-text {
  font-size: 26rpx;
  color: #9aa0ab;
  line-height: 1.8;
}

.photo-caption {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #98a0ad;
  line-height: 1.8;
}

.feature-list {
  display: flex;
  flex-direction: column;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #faf8ff 0%, #f5f9ff 100%);
  margin-bottom: 20rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background: linear-gradient(135deg, #7c5cf6 0%, #38bdf8 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-main {
  flex: 1;
  min-width: 0;
}

.feature-text {
  flex: 1;
  font-size: 27rpx;
  color: #4d5561;
  line-height: 1.85;
  word-break: break-all;
}

.content-panel {
  border-radius: 28rpx;
  padding: 28rpx 26rpx;
}

.content-panel-purple {
  background: linear-gradient(180deg, rgba(124, 92, 246, 0.09) 0%, rgba(124, 92, 246, 0.03) 100%);
}

.content-panel-blue {
  background: linear-gradient(180deg, rgba(56, 189, 248, 0.12) 0%, rgba(56, 189, 248, 0.04) 100%);
}

.content-line {
  font-size: 27rpx;
  color: #4d5561;
  line-height: 1.9;
  white-space: pre-wrap;
  margin-bottom: 18rpx;
}

.content-line:last-child {
  margin-bottom: 0;
}

.fun-list {
  display: flex;
  flex-direction: column;
}

.fun-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.fun-item:last-child {
  margin-bottom: 0;
}

.fun-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  margin-right: 16rpx;
  background: linear-gradient(135deg, #7c5cf6 0%, #a76dff 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fun-text {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #4d5561;
  line-height: 1.9;
  word-break: break-all;
  white-space: pre-wrap;
}

.emotion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.emotion-item {
  min-width: 160rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #eff5ff 0%, #f7f2ff 100%);
  border: 1rpx solid rgba(124, 92, 246, 0.12);
}

.emotion-name {
  font-size: 22rpx;
  color: #7f8ba0;
  line-height: 1.3;
}

.emotion-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #4f39cf;
  font-weight: 700;
  line-height: 1.2;
}

.ent-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ent-card {
  width: calc((100% - 16rpx) / 2);
  box-sizing: border-box;
  border-radius: 22rpx;
  padding: 22rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(124, 92, 246, 0.18);
}

.ent-card-wide {
  width: 100%;
  background: linear-gradient(180deg, rgba(124, 92, 246, 0.08) 0%, rgba(124, 92, 246, 0.02) 100%);
}

.ent-card-title {
  font-size: 27rpx;
  color: #3f2aae;
  font-weight: 700;
  line-height: 1.4;
}

.ent-card-content {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #4d5561;
  line-height: 1.75;
  white-space: pre-wrap;
}

.ent-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9aa0ab;
  line-height: 1.6;
}

.chat-section {
  margin-bottom: 0;
}

.chat-tips {
  font-size: 24rpx;
  color: #8e96a6;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.quick-question-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.quick-question {
  max-width: 100%;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(37, 132, 222, 0.24);
  background: rgba(255, 255, 255, 0.9);
  color: #246a9d;
  font-size: 25rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.quick-question-tip {
  margin-bottom: 24rpx;
  color: #8e96a6;
  font-size: 23rpx;
  line-height: 1.7;
}

.chat-list {
  display: flex;
  flex-direction: column;
}

.chat-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.chat-item:last-child {
  margin-bottom: 0;
}

.chat-item-user {
  flex-direction: row-reverse;
}

.chat-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  margin-top: 10rpx;
  background: linear-gradient(135deg, #7c5cf6 0%, #38bdf8 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chat-item-user .chat-avatar {
  background: linear-gradient(135deg, #ff8a65 0%, #ffb74d 100%);
}

.chat-main {
  max-width: calc(100% - 90rpx);
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.chat-item-user .chat-main {
  margin-left: 0;
  margin-right: 16rpx;
  align-items: flex-end;
}

.chat-image {
  width: 280rpx;
  height: 280rpx;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
  background: #f3f5fa;
}

.chat-bubble {
  max-width: 100%;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  font-size: 27rpx;
  line-height: 1.8;
  word-break: break-word;
  white-space: pre-wrap;
  box-sizing: border-box;
}

.chat-bubble-assistant {
  background: #f5f7ff;
  color: #445064;
  border-top-left-radius: 10rpx;
}

.chat-bubble-thinking {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  color: #66758a;
}

.thinking-text {
  font-size: 26rpx;
  line-height: 1.6;
}

.thinking-dots {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.thinking-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #8aa0c4;
  animation: thinkingDot 1s ease-in-out infinite;
}

.thinking-dot:nth-child(2) {
  animation-delay: 0.16s;
}

.thinking-dot:nth-child(3) {
  animation-delay: 0.32s;
}

.chat-bubble-user {
  background: linear-gradient(135deg, #7c5cf6 0%, #5baef5 100%);
  color: #ffffff;
  border-top-right-radius: 10rpx;
}

.page-bottom-space {
  height: 160rpx;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 28rpx rgba(77, 85, 97, 0.08);
  backdrop-filter: blur(16rpx);
  box-sizing: border-box;
}

.composer-preview {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 14rpx 10rpx 10rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #f6f7fb;
}

.composer-preview-image {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  margin-right: 14rpx;
  background: #e9edf3;
}

.composer-preview-remove {
  font-size: 24rpx;
  color: #f26d6d;
  line-height: 1.4;
}

.composer-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.composer-upload {
  flex-shrink: 0;
  min-width: 98rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: #f3f5fb;
  color: #5f6a7a;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.composer-upload-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: block;
}

.composer-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 26rpx;
  border-radius: 38rpx;
  background: #f5f7fb;
  font-size: 26rpx;
  color: #2b2b2b;
  box-sizing: border-box;
}

.composer-send {
  flex-shrink: 0;
  min-width: 104rpx;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 38rpx;
  background: #d6d9e2;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.composer-send-active {
  background: linear-gradient(135deg, #7c5cf6 0%, #38bdf8 100%);
}

.detail-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  padding: 48rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: rgba(12, 34, 58, 0.42);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-modal {
  width: 100%;
  max-height: 92vh;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 26rpx 70rpx rgba(12, 34, 58, 0.24);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.detail-modal-scroll-wrap {
  position: relative;
  display: flex;
  flex: 1;
  min-height: 0;
  flex-direction: column;
}

.detail-modal-drag-handle {
  width: 112rpx;
  height: 10rpx;
  margin: 0 auto 16rpx;
  border-radius: 999rpx;
  background: rgba(21, 124, 255, 0.24);
  box-shadow: 0 0 0 8rpx rgba(21, 124, 255, 0.07);
}

.detail-modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 18rpx;
}

.detail-modal-title {
  color: #123f66;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.45;
}

.detail-modal-intro {
  margin-top: 10rpx;
  color: #627686;
  font-size: 24rpx;
  line-height: 1.75;
}

.detail-modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f4f8fb;
  color: #6b7f8f;
  font-size: 40rpx;
  line-height: 52rpx;
  text-align: center;
  flex-shrink: 0;
}

.detail-highlight-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0 22rpx;
}

.detail-highlight-text {
  flex: 1;
  min-width: 0;
  color: #627686;
  font-size: 23rpx;
  line-height: 1.6;
}

.detail-modal-preview {
  margin: 6rpx 0 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f7fbff;
  border: 1rpx solid rgba(84, 118, 144, 0.14);
}

.detail-modal-preview-frame {
  border-radius: 0;
}

.detail-modal-preview-image {
  width: 100%;
  display: block;
  background: #eef5fb;
}

.detail-modal-focus-zone {
  margin-bottom: 20rpx;
}

.detail-modal-focus-title {
  margin-bottom: 14rpx;
  color: #123f66;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.detail-view-all {
  height: 54rpx;
  padding: 0 24rpx;
  border-radius: 27rpx;
  border: 1rpx solid rgba(42, 118, 182, 0.16);
  color: #245f93;
  background: #ffffff;
  font-size: 24rpx;
  line-height: 54rpx;
  flex-shrink: 0;
}

.detail-modal-scroll {
  max-height: 70vh;
  flex: 1;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

.detail-modal-block {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(84, 118, 144, 0.14);
  box-shadow: 0 8rpx 24rpx rgba(30, 82, 128, 0.06);
  box-sizing: border-box;
}

.detail-modal-block-primary {
  background: linear-gradient(180deg, #f2fffd 0%, #ffffff 100%);
  border-color: rgba(72, 188, 210, 0.34);
}

.detail-modal-block:last-child {
  margin-bottom: 0;
}

.detail-modal-scroll-cue {
  position: absolute;
  right: -2rpx;
  top: 50%;
  width: 68rpx;
  min-height: 250rpx;
  transform: translateY(-50%);
  pointer-events: none;
  padding: 28rpx 0;
  border-radius: 999rpx;
  background: rgba(237, 246, 255, 0.94);
  border: 1rpx solid rgba(21, 124, 255, 0.18);
  box-shadow: 0 12rpx 30rpx rgba(21, 124, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  z-index: 2;
}

.detail-modal-scroll-text {
  color: #0669e8;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 0;
  width: 30rpx;
  text-align: center;
  word-break: break-all;
}

.detail-modal-scroll-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-top: 0;
  border-right: 4rpx solid rgba(21, 124, 255, 0.9);
  border-bottom: 4rpx solid rgba(21, 124, 255, 0.9);
  transform: rotate(45deg);
  animation: detailScrollCue 1.2s ease-in-out infinite;
}

.detail-block-meta {
  color: #7b8d9a;
  font-size: 22rpx;
  line-height: 1.5;
}

.detail-block-title {
  margin-top: 6rpx;
  color: #142d3b;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.45;
}

.detail-block-line {
  margin-top: 12rpx;
  color: #5b6f7e;
  font-size: 24rpx;
  line-height: 1.75;
}

.detail-focus-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.detail-focus-card {
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f7fbff;
  border: 1rpx solid rgba(84, 118, 144, 0.14);
  box-sizing: border-box;
  cursor: pointer;
}

.detail-focus-frame .focus-point-label,
.focus-preview-frame .focus-point-label {
  font-size: 22rpx;
}

.detail-focus-title {
  margin-top: 14rpx;
  color: #123f66;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.detail-focus-desc {
  margin-top: 6rpx;
  color: #627686;
  font-size: 23rpx;
  line-height: 1.6;
}

.detail-block-images {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 22rpx;
}

.detail-block-img {
  width: calc((100% - 18rpx) / 2);
  height: 360rpx;
  border-radius: 18rpx;
  background: #eef5fb;
  display: block;
}

.focus-preview-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  padding: 40rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  background: rgba(12, 34, 58, 0.56);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.focus-preview-modal {
  width: 100%;
  max-height: 92vh;
  padding: 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 68rpx rgba(12, 34, 58, 0.26);
  box-sizing: border-box;
}

.focus-preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.focus-preview-title {
  flex: 1;
  min-width: 0;
  color: #123f66;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.focus-preview-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f4f8fb;
  color: #6b7f8f;
  font-size: 40rpx;
  line-height: 52rpx;
  text-align: center;
  flex-shrink: 0;
}

.focus-preview-body {
  margin-top: 20rpx;
}

.focus-preview-frame {
  border-radius: 24rpx;
}

.focus-preview-desc {
  margin-top: 18rpx;
  color: #627686;
  font-size: 24rpx;
  line-height: 1.7;
}

@keyframes detailScrollCue {
  0%, 100% {
    transform: rotate(45deg) translateY(0);
    opacity: 0.55;
  }
  50% {
    transform: rotate(45deg) translateY(4rpx);
    opacity: 1;
  }
}

@keyframes thinkingDot {
  0%, 80%, 100% {
    transform: translateY(0);
    opacity: 0.35;
  }

  40% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}
