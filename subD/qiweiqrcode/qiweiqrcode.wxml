<view class="page-shell">
  <view class="page-heading">
    <image class="brand-logo" src="https://wx.pmc-wz.com/materials/logo.png" mode="widthFix"></image>
    <view class="page-title">我的专属企微码</view>
    <view class="page-subtitle">微信扫码，添加和平体检客服</view>
  </view>

  <view class="code-area">
    <view class="code-frame">
      <image
        wx:if="{{qrcodeSrc}}"
        class="code-image"
        src="{{qrcodeSrc}}"
        mode="aspectFit"
        show-menu-by-longpress="true"
        bindtap="previewCode"
      ></image>

      <view wx:elif="{{loading}}" class="code-status">
        <view class="loading-ring"></view>
        <text>正在生成专属二维码</text>
      </view>

      <view wx:else class="code-status error-status">
        <view class="error-mark">!</view>
        <text>{{errorMessage}}</text>
        <button class="retry-button" bindtap="generateCode">重新生成</button>
      </view>
    </view>
    <view class="identity-line">
      <view class="identity-dot"></view>
      <text>已绑定当前微信身份</text>
    </view>
  </view>

  <button class="save-button {{qrcodeSrc ? '' : 'disabled'}}" bindtap="saveCode" disabled="{{!qrcodeSrc}}">保存到相册</button>
</view>
