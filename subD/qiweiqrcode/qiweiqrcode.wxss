page {
  min-height: 100%;
  background: #f4f7f8;
  color: #243840;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 70rpx 46rpx calc(56rpx + env(safe-area-inset-bottom));
}

.page-heading {
  text-align: center;
}

.brand-logo {
  width: 126rpx;
}

.page-title {
  margin-top: 34rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.page-subtitle {
  margin-top: 14rpx;
  color: #71848b;
  font-size: 25rpx;
  line-height: 1.5;
}

.code-area {
  margin-top: 70rpx;
}

.code-frame {
  box-sizing: border-box;
  display: flex;
  width: 560rpx;
  height: 560rpx;
  margin: 0 auto;
  padding: 34rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d9e4e7;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 14rpx 36rpx rgba(39, 71, 81, 0.08);
}

.code-image {
  width: 100%;
  height: 100%;
}

.code-status {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  color: #7a8d94;
  font-size: 25rpx;
}

.loading-ring {
  box-sizing: border-box;
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 24rpx;
  border: 5rpx solid #dce8ea;
  border-top-color: #2b7f87;
  border-radius: 50%;
  animation: rotate 0.8s linear infinite;
}

.error-mark {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 22rpx;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #b85b55;
  border-radius: 50%;
  color: #b85b55;
  font-size: 34rpx;
  font-weight: 700;
}

.retry-button {
  width: 190rpx;
  height: 66rpx;
  margin-top: 28rpx;
  padding: 0;
  border: 1rpx solid #9db5bc;
  border-radius: 6rpx;
  background: #fff;
  color: #41636d;
  font-size: 25rpx;
  line-height: 64rpx;
}

.retry-button::after,
.save-button::after {
  border: 0;
}

.identity-line {
  display: flex;
  margin-top: 24rpx;
  align-items: center;
  justify-content: center;
  color: #75878e;
  font-size: 23rpx;
}

.identity-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #2b8a78;
}

.save-button {
  width: 560rpx;
  height: 88rpx;
  margin: 54rpx auto 0;
  padding: 0;
  border: 0;
  border-radius: 6rpx;
  background: #2b7f87;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.save-button.disabled {
  background: #b8c6ca;
  color: #edf2f3;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
