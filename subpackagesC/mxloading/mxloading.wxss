page {
  height: 100%;
  padding-bottom: 0 !important;
}

.page {
  min-height: 100%;
  padding: 240rpx 48rpx 60rpx;
  box-sizing: border-box;
  text-align: center;
  background: linear-gradient(180deg, #58aaf3 0%, #8dc8fb 58%, #cfe7ff 100%);
}

.title {
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.2;
}

.subtitle {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  line-height: 1.6;
}

.circle-wrap {
  position: relative;
  width: 480rpx;
  height: 480rpx;
  margin: 100rpx auto 0;
}

.canvas {
  display: block;
}

.center-text {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.num {
  color: #ffffff;
  font-size: 90rpx;
  font-weight: 800;
  line-height: 1;
  text-shadow: 0 0 30rpx rgba(20, 122, 255, 0.35);
}

.sign {
  margin-left: 4rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
  text-shadow: 0 0 24rpx rgba(20, 122, 255, 0.3);
}

.hint {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  margin-top: 100rpx;
  padding: 0 34rpx;
  border-radius: 30rpx;
  background: rgba(18, 106, 198, 0.26);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.5;
  box-sizing: border-box;
}

.timing-card {
  width: 100%;
  margin: 28rpx auto 0;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  background: rgba(255, 255, 255, 0.16);
  box-shadow: 0 18rpx 42rpx rgba(23, 103, 184, 0.16);
  box-sizing: border-box;
  text-align: left;
}

.request-state-card {
  width: 100%;
  margin: 28rpx auto 0;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  background: rgba(255, 255, 255, 0.14);
  box-shadow: 0 18rpx 42rpx rgba(23, 103, 184, 0.12);
  box-sizing: border-box;
  text-align: left;
}

.request-state-title {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.4;
}

.request-state-text {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 23rpx;
  line-height: 1.7;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.timing-title {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.4;
}

.timing-text {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 23rpx;
  line-height: 1.7;
  word-break: break-word;
  overflow-wrap: anywhere;
}
