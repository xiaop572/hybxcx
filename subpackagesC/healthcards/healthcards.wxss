page {
  min-height: 100%;
  background: #f6f6f6;
}

.cards-page {
  min-height: 100vh;
  padding: 48rpx 58rpx 80rpx;
  box-sizing: border-box;
  background: #f6f6f6;
}

.section-head {
  display: flex;
  align-items: center;
  margin: 22rpx 0 22rpx;
}

.title-mark {
  width: 14rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background: #0e83ee;
}

.title-en {
  color: #a4a4a4;
  font-size: 25rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}

.title-cn {
  margin-top: 10rpx;
  color: #070707;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.08;
}

.desc {
  color: #6f6f6f;
  font-size: 27rpx;
  line-height: 1.65;
}

.medical-card {
  position: relative;
  display: flex;
  align-items: center;
  height: 164rpx;
  margin-top: 34rpx;
  padding: 0 40rpx;
  border-radius: 13rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(100deg, #1498f2 0%, #45b8f6 55%, #78cdf8 100%);
  box-shadow: 0 4rpx 8rpx rgba(34, 126, 195, 0.12);
}

.card-avatar {
  position: relative;
  z-index: 2;
  width: 76rpx;
  height: 76rpx;
  margin-right: 28rpx;
  border-radius: 50%;
  background: #eff9ff;
  flex-shrink: 0;
}

.avatar-head {
  position: absolute;
  left: 50%;
  top: 18rpx;
  width: 25rpx;
  height: 25rpx;
  margin-left: -12rpx;
  border-radius: 50%;
  background: #1388e8;
}

.avatar-body {
  position: absolute;
  left: 21rpx;
  bottom: 18rpx;
  width: 34rpx;
  height: 19rpx;
  border-radius: 19rpx 19rpx 6rpx 6rpx;
  background: #1388e8;
}

.card-info {
  position: relative;
  z-index: 2;
}

.card-name {
  color: #fff;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1;
}

.card-no {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 27rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}

.card-extra {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  line-height: 1;
}

.empty {
  margin-top: 48rpx;
  color: #9a9a9a;
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
}

.watermark {
  position: absolute;
  right: 20rpx;
  bottom: -4rpx;
  color: rgba(255, 255, 255, 0.12);
  font-size: 112rpx;
  font-weight: 700;
  letter-spacing: -8rpx;
  line-height: 1;
}
