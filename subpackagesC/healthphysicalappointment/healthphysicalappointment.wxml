<view class="page">
  <view class="header-card">
    <view class="card-title">体检预约记录</view>
    <view class="card-subtitle">{{personName}} {{personPhone}}</view>
    <view class="card-tip">基于当前亲情卡信息查询</view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view class="empty" wx:elif="{{!list.length}}">{{emptyText || '暂无体检预约记录'}}</view>

  <view wx:else class="list">
    <view class="record-item" wx:for="{{list}}" wx:key="id">
      <view class="record-top">
        <view class="record-name">{{item.goodsName}}</view>
        <view class="record-status">{{item.status}}</view>
      </view>
      <view class="record-row">
        <text class="label">预约人</text>
        <text>{{item.name}}</text>
      </view>
      <view class="record-row" wx:if="{{item.phone}}">
        <text class="label">手机号</text>
        <text>{{item.phone}}</text>
      </view>
      <view class="record-row" wx:if="{{item.time}}">
        <text class="label">时间</text>
        <text>{{item.time}}</text>
      </view>
      <view class="record-row" wx:if="{{item.cardno}}">
        <text class="label">证件号</text>
        <text>{{item.cardno}}</text>
      </view>
      <button
        class="cancel-btn"
        wx:if="{{item.canCancel}}"
        bindtap="cancelAppointment"
        data-index="{{index}}"
        loading="{{cancelingId == item.id}}"
        disabled="{{cancelingId == item.id}}"
      >取消预约</button>
    </view>
  </view>
</view>
